{
  "name": "cwg",
  "private": true,
  "version": "0.1.0",
  "description": "CWG — Connect With Growers (mobile-first monorepo)",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @cwg/web dev",
    "dev:mobile": "pnpm --filter @cwg/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
