# =============================================================================
# CWG — environment template (copy to .env / app-local env; never commit secrets)
# =============================================================================

# --- Supabase (same project for web + mobile) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server / Edge / CI only — NEVER ship to clients
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=

# --- Apps ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_ENV=development

# Google Play listing (placeholder package until real app id exists)
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=br.com.cwg.app
EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=br.com.cwg.app

# --- Google OAuth (Supabase Auth → Providers → Google) ---
# Enable Google in the Supabase dashboard and set Authorized redirect URIs to:
#   {SUPABASE_URL}/auth/v1/callback
# Also add your app callback:
#   {NEXT_PUBLIC_SITE_URL}/auth/callback
# Client ID/secret live in the Supabase dashboard (not required in app env when using Supabase-hosted OAuth).
# Optional local/dev overrides if you self-host or use direct Google Sign-In later:
# GOOGLE_AUTH_CLIENT_ID=
# GOOGLE_AUTH_CLIENT_SECRET=

# --- Deferred (Phase 2+) — declare only; unused in Phase 1 ---
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# EXPO_ACCESS_TOKEN=
# RESEND_API_KEY=
